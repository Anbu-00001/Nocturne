<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Debug builds only. DUMP is held by adb's shell and never granted to apps, so nothing on the phone can send this. -->
        <receiver
            android:name=".debug.DebugReportReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
    </application>
</manifest>
