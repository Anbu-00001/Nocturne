<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Optional: only shows the light sampler's notification. The service runs without it (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Focus timer (spec §7): its end is an exact alarm, which fires in Doze. USE_EXACT_ALARM is granted at install from
         Android 13; Google Play limits it to timer and alarm apps, and Nocturne is not distributed there. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Phase 5 (spec §8 allowed the network from Phase 4 on; Phases 1-3 had none): Wi-Fi sync with the paired laptop. Every
         connection is made by core-model's SyncClient, to private addresses only, pinned to the laptop's certificate; no other
         code in the app opens a socket (core-model's NetworkSurfaceTest). To go back to no network, restore
         android:name="android.permission.INTERNET" tools:node="remove" here: sync then fails with a permission error and
         nothing else changes. If targetSdk ever reaches 37, Android 17 also needs ACCESS_LOCAL_NETWORK, a runtime permission, for this.
         ACCESS_NETWORK_STATE is how the app sees that it is on Wi-Fi; WorkManager's network constraint needs it too. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- App names for "mostly Instagram" without QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- allowBackup=false: cloud backup would move the data off the phone. Use CSV export instead. -->
    <application
        android:name=".NocturneApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="Nocturne"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar"
        tools:ignore="HardcodedText">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".focus.FocusAlarmReceiver"
            android:exported="false" />

        <!-- Phase 4: laptop use in, sessions and nights out, over adb's `content` command (Phase 5 adds `pair`, which gives the
             phone the laptop's address, certificate fingerprint and secret; that too needs adb's DUMP, so nothing on the phone
             can pair it with another computer). DUMP is held by adb's shell and
             cannot be granted to ordinary apps, so no app on the phone can read the history through this. -->
        <provider
            android:name=".laptop.LaptopBridgeProvider"
            android:authorities="${applicationId}.laptop"
            android:exported="true"
            android:readPermission="android.permission.DUMP"
            android:writePermission="android.permission.DUMP"
            tools:ignore="ExportedContentProvider" />
    </application>
</manifest>
