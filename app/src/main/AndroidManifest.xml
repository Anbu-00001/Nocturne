<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Optional: only shows the light sampler's notification. The service runs without it (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Focus timer (spec §7): its end is an exact alarm, which fires in Doze. USE_EXACT_ALARM is granted at install from
         Android 13; Google Play limits it to timer and alarm apps, and Nocturne is not distributed there. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- No network in Phases 1-3 (spec §8): stripped even if a library asks for it. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />

    <!-- App names for "mostly Instagram" without QUERY_ALL_PACKAGES. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- allowBackup=false: cloud backup would move the data off the phone. Use CSV export instead. -->
    <application
        android:name=".NocturneApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="Nocturne"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar"
        tools:ignore="HardcodedText">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".focus.FocusAlarmReceiver"
            android:exported="false" />
    </application>
</manifest>
